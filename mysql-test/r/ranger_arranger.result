SELECT INT8RANGE_MAKE(1, 5, '[]') AS r;
r
[1,6)
SELECT INT8RANGE_LOWER(INT8RANGE_MAKE(1, 5, '[]')) AS v;
v
1
SELECT INT8RANGE_UPPER(INT8RANGE_MAKE(1, 5, '[]')) AS v;
v
6
SELECT INT8RANGE_MAKE(1, 5, '[]') = INT8RANGE_MAKE(1, 6, '[)') AS eq;
eq
1
SELECT INT8RANGE_MAKE(1, 5, '[]') = INT8RANGE_MAKE(1, 6, '[)') AS eq;
eq
1
SELECT INT8RANGE_MAKE(1, 5, '[]') AS r;
r
[1,6)
SELECT INT8RANGE_LOWER(INT8RANGE_MAKE(1, 5, '[]')) AS v;
v
1
