INSTALL EXTENSION vsql_ranger_arranger;
SELECT INT8MULTIRANGE_MAKE('{[10,20)}') AS v;
v
{[10,20)}
SELECT INT8MULTIRANGE_LOWER(INT8MULTIRANGE_MAKE('{[10,20)}')) AS v;
v
{[10,20)}
SELECT INT8MULTIRANGE_LOWER(INT8MULTIRANGE_MAKE('{[10,20),[30,40)}')) AS v;
v
{[10,20),[30,40)}
SELECT INT8MULTIRANGE_OVERLAPS(INT8MULTIRANGE_MAKE('{[1,10)}'), INT8MULTIRANGE_MAKE('{[5,15)}')) AS overlaps;
overlaps
1
SELECT INT8MULTIRANGE_INTERSECT(INT8MULTIRANGE_MAKE('{[1,10)}'), INT8MULTIRANGE_MAKE('{[5,15)}')) AS inter;
inter
{[5,10)}
SELECT INT8MULTIRANGE_MERGE(INT8MULTIRANGE_MAKE('{[1,5)}'), INT8MULTIRANGE_MAKE('{[5,10)}')) AS merge;
merge
{[1,10)}
SELECT INT8MULTIRANGE_DIFFERENCE(INT8MULTIRANGE_MAKE('{[1,10)}'), INT8MULTIRANGE_MAKE('{[3,7)}')) AS diff;
diff
{[1,3),[7,10)}
SELECT INT8MULTIRANGE_CONTAINS_RANGE(INT8MULTIRANGE_MAKE('{[1,10)}'), INT8MULTIRANGE_MAKE('{[3,7)}')) AS contains;
contains
1
