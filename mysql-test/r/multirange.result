INSTALL EXTENSION vsql_ranger_arranger;
SELECT INT8MULTIRANGE_MAKE('{[10,20)}') AS v;
v
{[10,20)}
SELECT INT8MULTIRANGE_LOWER(INT8MULTIRANGE_MAKE('{[10,20)}')) AS v;
v
{[10,20)}
SELECT INT8MULTIRANGE_LOWER(INT8MULTIRANGE_MAKE('{[10,20),[30,40)}')) AS v;
v
{[10,20),[30,40)}
SELECT INT4MULTIRANGE_MAKE('{[1,5)}') AS v;
v
{[1,5)}
SELECT INT4MULTIRANGE_LOWER(INT4MULTIRANGE_MAKE('{[1,5)}')) AS v;
v
{[1,5)}
SELECT INT4MULTIRANGE_LOWER(INT4MULTIRANGE_MAKE('{[1,5),[10,15)}')) AS v;
v
{[1,5),[10,15)}
SELECT DATEMULTIRANGE_MAKE('{[2026-01-01,2026-01-05)}') AS v;
v
{[2026-01-01,2026-01-05)}
SELECT DATEMULTIRANGE_LOWER(DATEMULTIRANGE_MAKE('{[2026-01-01,2026-01-05)}')) AS v;
v
{[2026-01-01,2026-01-05)}
SELECT DATEMULTIRANGE_LOWER(DATEMULTIRANGE_MAKE('{[2026-01-01,2026-01-05),[2026-01-10,2026-01-15)}')) AS v;
v
{[2026-01-01,2026-01-05),[2026-01-10,2026-01-15)}
SELECT DATETIMEMULTIRANGE_MAKE('{[2026-01-01 00:00:00,2026-01-05 00:00:00)}') AS v;
v
{[2026-01-01 00:00:00.000000,2026-01-05 00:00:00.000000)}
SELECT DATETIMEMULTIRANGE_LOWER(DATETIMEMULTIRANGE_MAKE('{[2026-01-01 00:00:00,2026-01-05 00:00:00)}')) AS v;
v
{[2026-01-01 00:00:00.000000,2026-01-05 00:00:00.000000)}
SELECT DATETIMEMULTIRANGE_LOWER(DATETIMEMULTIRANGE_MAKE('{[2026-01-01 00:00:00,2026-01-05 00:00:00),[2026-01-10 00:00:00,2026-01-15 00:00:00)}')) AS v;
v
{[2026-01-01 00:00:00.000000,2026-01-05 00:00:00.000000),[2026-01-10 00:00:00.000000,2026-01-15 00:00:00.000000)}
CREATE TABLE tm (a INT8MULTIRANGE);
INSERT INTO tm VALUES (INT8MULTIRANGE_MAKE('{[10,20)}'));
SELECT a FROM tm;
a
{[10,20)}
SELECT INT8MULTIRANGE_LOWER(a) FROM tm;
INT8MULTIRANGE_LOWER(a)
{[10,20)}
DROP TABLE tm;
