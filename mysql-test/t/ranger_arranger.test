--echo # ===== ranger-arranger v0.1 live smoke test (constructors, predicates, set ops, extractors) =====
INSTALL EXTENSION vsql_ranger_arranger;

--echo # --- INT8RANGE constructor + accessors ---
SELECT INT8RANGE_MAKE(1, 5, '[]');
SELECT INT8RANGE_LOWER(INT8RANGE_MAKE(1, 5, '[]'));
SELECT INT8RANGE_UPPER(INT8RANGE_MAKE(1, 5, '[]'));
SELECT INT8RANGE_LOWER_INC(INT8RANGE_MAKE(1, 5, '[]'));
SELECT INT8RANGE_UPPER_INC(INT8RANGE_MAKE(1, 5, '[]'));
-- inclusive-upper literal canonicalizes: [1,5] -> stored as the [1,6) point-set
SELECT INT8RANGE_UPPER(INT8RANGE_MAKE(1, 5, '[)'));
SELECT INT8RANGE_LENGTH(INT8RANGE_MAKE(1, 5, '[)'));

--echo # --- empty + infinite ---
SELECT INT8RANGE_ISEMPTY(INT8RANGE_EMPTY());
SELECT INT8RANGE_LOWER(INT8RANGE_MAKE(-infinity, 10, '[)'));
SELECT INT8RANGE_UPPER(INT8RANGE_MAKE(1, +infinity, '[)'));

--echo # --- predicates ---
SELECT INT8RANGE_OVERLAPS(INT8RANGE_MAKE(1,5,'[)'), INT8RANGE_MAKE(3,8,'[)'));
SELECT INT8RANGE_CONTAINS_RANGE(INT8RANGE_MAKE(1,10,'[)'), INT8RANGE_MAKE(3,6,'[)'));
SELECT INT8RANGE_CONTAINS_RANGE(INT8RANGE_MAKE(3,6,'[)'), INT8RANGE_MAKE(1,10,'[)'));
SELECT INT8RANGE_ADJACENT(INT8RANGE_MAKE(1,5,'[)'), INT8RANGE_MAKE(5,9,'[)'));
SELECT INT8RANGE_BEFORE(INT8RANGE_MAKE(1,5,'[)'), INT8RANGE_MAKE(7,9,'[)'));
-- canonical equality: [1,5] == [1,6)
SELECT INT8RANGE_EQUALS(INT8RANGE_MAKE(1,5,'[]'), INT8RANGE_MAKE(1,6,'[)'));

--echo # --- set operations ---
SELECT INT8RANGE_INTERSECT(INT8RANGE_MAKE(1,5,'[)'), INT8RANGE_MAKE(3,8,'[)'));
SELECT INT8RANGE_MERGE(INT8RANGE_MAKE(1,5,'[)'), INT8RANGE_MAKE(10,15,'[)'));
-- RANGE_UNION on disjoint must error (use RANGE_MERGE for enclosing interval)
--disable_abort_on_error
SELECT INT8RANGE_UNION(INT8RANGE_MAKE(1,5,'[)'), INT8RANGE_MAKE(10,15,'[)'));
--enable_abort_on_error
SELECT INT8RANGE_DIFFERENCE(INT8RANGE_MAKE(1,10,'[)'), INT8RANGE_MAKE(3,6,'[)'));

--echo # --- INT4RANGE (narrower endpoint width) ---
SELECT INT4RANGE_INTERSECT(INT4RANGE_MAKE(1,50,'[)'), INT4RANGE_MAKE(20,80,'[)'));
SELECT INT4RANGE_OVERLAPS(INT4RANGE_MAKE(1,50,'[)'), INT4RANGE_MAKE(20,80,'[)'));

--echo # --- DATERANGE (continuous-style literal round-trips) ---
SELECT DATERANGE_LOWER(DATERANGE_MAKE('2026-01-01', '2026-01-31', '[]'));
SELECT DATERANGE_UPPER(DATERANGE_MAKE('2026-01-01', '2026-01-31', '[]'));
SELECT DATERANGE_LOWER_INC(DATERANGE_MAKE('2026-01-01', '2026-01-31', '[]'));
SELECT DATERANGE_UPPER_INC(DATERANGE_MAKE('2026-01-01', '2026-01-31', '[]'));
SELECT DATERANGE_LENGTH(DATERANGE_MAKE('2026-01-01', '2026-01-31', '[]'));
SELECT DATERANGE_ISEMPTY(DATERANGE_EMPTY());
SELECT DATERANGE_INTERSECT(DATERANGE_MAKE('2026-01-01','2026-01-31','[)'), DATERANGE_MAKE('2026-01-15','2026-02-28','[)'));
SELECT DATERANGE_CONTAINS_RANGE(DATERANGE_MAKE('2026-01-01','2026-12-31','[)'), DATERANGE_MAKE('2026-03-01','2026-06-01','[)'));
SELECT DATERANGE_ADJACENT(DATERANGE_MAKE('2026-01-01','2026-01-31','[)'), DATERANGE_MAKE('2026-01-31','2026-02-28','[)'));
SELECT DATERANGE_BEFORE(DATERANGE_MAKE('2026-01-01','2026-01-31','[)'), DATERANGE_MAKE('2026-03-01','2026-03-31','[)'));
SELECT DATERANGE_EQUALS(DATERANGE_MAKE('2026-01-01','2026-01-31','[]'), DATERANGE_MAKE('2026-01-01','2026-02-01','[)'));
SELECT DATERANGE_DIFFERENCE(DATERANGE_MAKE('2026-01-01','2026-01-31','[)'), DATERANGE_MAKE('2026-01-10','2026-01-20','[)'));

--echo # --- DATETIMERANGE (microsecond precision preserved) ---
SELECT DATETIMERANGE_LOWER(DATETIMERANGE_MAKE('2026-01-01 00:00:00','2026-01-02 00:00:00','[]'));
SELECT DATETIMERANGE_LOWER_INC(DATETIMERANGE_MAKE('2026-01-01 00:00:00','2026-01-02 00:00:00','[]'));
SELECT DATETIMERANGE_LENGTH(DATETIMERANGE_MAKE('2026-01-01 00:00:00','2026-01-02 00:00:00','[]'));
SELECT DATETIMERANGE_CONTAINS_RANGE(DATETIMERANGE_MAKE('2026-01-01 00:00:00','2026-01-03 00:00:00','[)'), DATETIMERANGE_MAKE('2026-01-01 12:00:00','2026-01-02 00:00:00','[)'));
SELECT DATETIMERANGE_ADJACENT(DATETIMERANGE_MAKE('2026-01-01 00:00:00','2026-01-02 00:00:00','[)'), DATETIMERANGE_MAKE('2026-01-02 00:00:00','2026-01-03 00:00:00','[)'));

--echo # --- NULL handling ---
SELECT INT8RANGE_OVERLAPS(NULL, INT8RANGE_MAKE(1,5,'[)'));
SELECT INT8RANGE_MAKE(NULL, 5, '[]');

--echo # === Round-trip persistence ===
CREATE TABLE t_int8 (r INT8RANGE);
INSERT INTO t_int8 VALUES (INT8RANGE_MAKE(1, 5, '[)'));
SELECT r FROM t_int8;
SELECT INT8RANGE_LOWER(r), INT8RANGE_UPPER(r), INT8RANGE_LENGTH(r) FROM t_int8;
DROP TABLE t_int8;

CREATE TABLE t_date (r DATERANGE);
INSERT INTO t_date VALUES (DATERANGE_MAKE('2026-01-01', '2026-01-31', '[]'));
SELECT r, DATERANGE_LOWER_INC(r), DATERANGE_UPPER_INC(r) FROM t_date;
DROP TABLE t_date;

--echo # === Scheduling scenario ===
CREATE TABLE bookings (room INT, booked DATERANGE);
INSERT INTO bookings VALUES (1, DATERANGE_MAKE('2026-01-10','2026-01-15','[)'));
INSERT INTO bookings VALUES (1, DATERANGE_MAKE('2026-01-16','2026-01-20','[)'));

SELECT DATERANGE_DIFFERENCE(
  DATERANGE_MAKE('2026-01-01','2026-01-31','[)'),
  DATERANGE_MAKE('2026-01-10','2026-01-15','[)')
);

SELECT DATERANGE_OVERLAPS(
  DATERANGE_MAKE('2026-01-12','2026-01-14','[)'),
  DATERANGE_MAKE('2026-01-10','2026-01-15','[)')
);

SELECT DATERANGE_OVERLAPS(
  DATERANGE_MAKE('2026-01-16','2026-01-20','[)'),
  DATERANGE_MAKE('2026-01-10','2026-01-15','[)')
);
DROP TABLE bookings;

--echo # === Anti-lossy gap decomposition ===
SELECT INT8RANGE_DIFFERENCE(
  INT8RANGE_MAKE(1, 10, '[)'),
  INT8RANGE_MAKE(3, 6, '[)')
);

--echo # === NULL-safe algebra in queries ===
CREATE TABLE nullable_test (r INT8RANGE);
INSERT INTO nullable_test VALUES (INT8RANGE_MAKE(1, 5, '[)'));
INSERT INTO nullable_test VALUES (NULL);

SELECT COUNT(*) FROM nullable_test WHERE INT8RANGE_OVERLAPS(r, INT8RANGE_MAKE(3, 8, '[)'));
SELECT COUNT(*) FROM nullable_test WHERE r IS NULL;
DROP TABLE nullable_test;

--echo # === Empty + infinity round-trip ===
CREATE TABLE edge_cases (r DATERANGE);
INSERT INTO edge_cases VALUES (DATERANGE_EMPTY());

SELECT DATERANGE_ISEMPTY(r) FROM edge_cases WHERE r = DATERANGE_EMPTY();
DROP TABLE edge_cases;

UNINSTALL EXTENSION vsql_ranger_arranger;
