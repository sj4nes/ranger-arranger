# ===== ranger-arranger v0.1 live smoke test (constructors, predicates, set ops, extractors) =====
# extension installed by mysql-test.multirange (runs first)
# INSTALL EXTENSION vsql_ranger_arranger;

# --- INT8RANGE constructor + accessors ---
SELECT INT8RANGE_MAKE(1, 5, '[]') AS r;
SELECT INT8RANGE_LOWER(INT8RANGE_MAKE(1, 5, '[]')) AS v;
SELECT INT8RANGE_UPPER(INT8RANGE_MAKE(1, 5, '[]')) AS v;

# inclusive-upper canonicalizes: [1,5] == [1,6)
SELECT INT8RANGE_MAKE(1, 5, '[]') = INT8RANGE_MAKE(1, 6, '[)') AS eq;
SELECT INT8RANGE_MAKE(1, 5, '[]') = INT8RANGE_MAKE(1, 6, '[)') AS eq;

# --- range predicates ---
SELECT INT8RANGE_MAKE(1, 5, '[]') AS r;
SELECT INT8RANGE_LOWER(INT8RANGE_MAKE(1, 5, '[]')) AS v;
SELECT INT8RANGE_LOWER_INC(INT8RANGE_MAKE(1, 5, '[]')) AS v;
SELECT INT8RANGE_UPPER_INC(INT8RANGE_MAKE(1, 5, '[]')) AS v;
SELECT INT8RANGE_LOWER(INT8RANGE_EMPTY()) AS v;
SELECT INT8RANGE_UPPER(INT8RANGE_EMPTY()) AS v;

# --- INT4RANGE ---
SELECT INT4RANGE_MAKE(1, 5, '[]') AS r;
SELECT INT4RANGE_LOWER(INT4RANGE_MAKE(1, 5, '[]')) AS v;
SELECT INT4RANGE_UPPER(INT4RANGE_MAKE(1, 5, '[]')) AS v;

# --- persistence round-trip ---
CREATE TABLE tm (a INT8MULTIRANGE);
INSERT INTO tm VALUES (INT8MULTIRANGE_MAKE('{[10,20)}'));
SELECT a FROM tm;
SELECT INT8MULTIRANGE_LOWER(a) FROM tm;
DROP TABLE tm;
