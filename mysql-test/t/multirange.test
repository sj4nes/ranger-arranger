# ===== multirange live smoke test (MAKE, LOWER, algebra, persistence) =====
INSTALL EXTENSION vsql_ranger_arranger;

# --- INT8MULTIRANGE ---
SELECT INT8MULTIRANGE_MAKE('{[10,20)}') AS v;
SELECT INT8MULTIRANGE_LOWER(INT8MULTIRANGE_MAKE('{[10,20)}')) AS v;
SELECT INT8MULTIRANGE_LOWER(INT8MULTIRANGE_MAKE('{[10,20),[30,40)}')) AS v;
SELECT INT8MULTIRANGE_OVERLAPS(INT8MULTIRANGE_MAKE('{[1,10)}'), INT8MULTIRANGE_MAKE('{[5,15)}')) AS overlaps;
SELECT INT8MULTIRANGE_INTERSECT(INT8MULTIRANGE_MAKE('{[1,10)}'), INT8MULTIRANGE_MAKE('{[5,15)}')) AS inter;
SELECT INT8MULTIRANGE_MERGE(INT8MULTIRANGE_MAKE('{[1,5)}'), INT8MULTIRANGE_MAKE('{[5,10)}')) AS merge;
SELECT INT8MULTIRANGE_DIFFERENCE(INT8MULTIRANGE_MAKE('{[1,10)}'), INT8MULTIRANGE_MAKE('{[3,7)}')) AS diff;
SELECT INT8MULTIRANGE_CONTAINS_RANGE(INT8MULTIRANGE_MAKE('{[1,10)}'), INT8MULTIRANGE_MAKE('{[3,7)}')) AS contains;

# --- INT4MULTIRANGE ---
SELECT INT4MULTIRANGE_MAKE('{[1,5)}') AS v;
SELECT INT4MULTIRANGE_LOWER(INT4MULTIRANGE_MAKE('{[1,5)}')) AS v;
SELECT INT4MULTIRANGE_LOWER(INT4MULTIRANGE_MAKE('{[1,5),[10,15)}')) AS v;
SELECT INT4MULTIRANGE_OVERLAPS(INT4MULTIRANGE_MAKE('{[1,5)}'), INT4MULTIRANGE_MAKE('{[3,8)}')) AS overlaps;
SELECT INT4MULTIRANGE_INTERSECT(INT4MULTIRANGE_MAKE('{[1,10)}'), INT4MULTIRANGE_MAKE('{[5,15)}')) AS inter;
SELECT INT4MULTIRANGE_MERGE(INT4MULTIRANGE_MAKE('{[1,5)}'), INT4MULTIRANGE_MAKE('{[5,10)}')) AS merge;
SELECT INT4MULTIRANGE_DIFFERENCE(INT4MULTIRANGE_MAKE('{[1,10)}'), INT4MULTIRANGE_MAKE('{[3,7)}')) AS diff;
SELECT INT4MULTIRANGE_CONTAINS_RANGE(INT4MULTIRANGE_MAKE('{[1,10)}'), INT4MULTIRANGE_MAKE('{[3,7)}')) AS contains;

# --- DATEMULTIRANGE ---
SELECT DATEMULTIRANGE_MAKE('{[2026-01-01,2026-01-05)}') AS v;
SELECT DATEMULTIRANGE_LOWER(DATEMULTIRANGE_MAKE('{[2026-01-01,2026-01-05)}')) AS v;
SELECT DATEMULTIRANGE_LOWER(DATEMULTIRANGE_MAKE('{[2026-01-01,2026-01-05),[2026-01-10,2026-01-15)}')) AS v;
SELECT DATEMULTIRANGE_OVERLAPS(DATEMULTIRANGE_MAKE('{[2026-01-01,2026-01-05)}'), DATEMULTIRANGE_MAKE('{[2026-01-03,2026-01-07)}')) AS overlaps;
SELECT DATEMULTIRANGE_INTERSECT(DATEMULTIRANGE_MAKE('{[2026-01-01,2026-01-05)}'), DATEMULTIRANGE_MAKE('{[2026-01-03,2026-01-07)}')) AS inter;
SELECT DATEMULTIRANGE_MERGE(DATEMULTIRANGE_MAKE('{[2026-01-01,2026-01-05)}'), DATEMULTIRANGE_MAKE('{[2026-01-05,2026-01-10)}')) AS merge;
SELECT DATEMULTIRANGE_DIFFERENCE(DATEMULTIRANGE_MAKE('{[2026-01-01,2026-01-10)}'), DATEMULTIRANGE_MAKE('{[2026-01-03,2026-01-07)}')) AS diff;
SELECT DATEMULTIRANGE_CONTAINS_RANGE(DATEMULTIRANGE_MAKE('{[2026-01-01,2026-01-10)}'), DATEMULTIRANGE_MAKE('{[2026-01-03,2026-01-07)}')) AS contains;

# --- DATETIMEMULTIRANGE ---
SELECT DATETIMEMULTIRANGE_MAKE('{[2026-01-01 00:00:00,2026-01-05 00:00:00)}') AS v;
SELECT DATETIMEMULTIRANGE_LOWER(DATETIMEMULTIRANGE_MAKE('{[2026-01-01 00:00:00,2026-01-05 00:00:00)}')) AS v;
SELECT DATETIMEMULTIRANGE_LOWER(DATETIMEMULTIRANGE_MAKE('{[2026-01-01 00:00:00,2026-01-05 00:00:00),[2026-01-10 00:00:00,2026-01-15 00:00:00)}')) AS v;
SELECT DATETIMEMULTIRANGE_OVERLAPS(DATETIMEMULTIRANGE_MAKE('{[2026-01-01 00:00:00,2026-01-05 00:00:00)}'), DATETIMEMULTIRANGE_MAKE('{[2026-01-03 00:00:00,2026-01-07 00:00:00)}')) AS overlaps;
SELECT DATETIMEMULTIRANGE_INTERSECT(DATETIMEMULTIRANGE_MAKE('{[2026-01-01 00:00:00,2026-01-05 00:00:00)}'), DATETIMEMULTIRANGE_MAKE('{[2026-01-03 00:00:00,2026-01-07 00:00:00)}')) AS inter;
SELECT DATETIMEMULTIRANGE_MERGE(DATETIMEMULTIRANGE_MAKE('{[2026-01-01 00:00:00,2026-01-05 00:00:00)}'), DATETIMEMULTIRANGE_MAKE('{[2026-01-05 00:00:00,2026-01-10 00:00:00)}')) AS merge;
SELECT DATETIMEMULTIRANGE_DIFFERENCE(DATETIMEMULTIRANGE_MAKE('{[2026-01-01 00:00:00,2026-01-10 00:00:00)}'), DATETIMEMULTIRANGE_MAKE('{[2026-01-03 00:00:00,2026-01-07 00:00:00)}')) AS diff;
SELECT DATETIMEMULTIRANGE_CONTAINS_RANGE(DATETIMEMULTIRANGE_MAKE('{[2026-01-01 00:00:00,2026-01-10 00:00:00)}'), DATETIMEMULTIRANGE_MAKE('{[2026-01-03 00:00:00,2026-01-07 00:00:00)}')) AS contains;

# --- persistence round-trip ---
CREATE TABLE tm (a INT8MULTIRANGE);
INSERT INTO tm VALUES (INT8MULTIRANGE_MAKE('{[10,20)}'));
SELECT a FROM tm;
SELECT INT8MULTIRANGE_LOWER(a) FROM tm;
DROP TABLE tm;
